{
    "name": "emitwave/php",
    "description": "EmitWave server publishing and realtime authentication SDK (framework-free).",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/emitwave/emitwave-php",
    "keywords": ["emitwave", "realtime", "publish", "events", "websocket"],
    "authors": [{ "name": "EmitWave" }],
    "support": {
        "issues": "https://github.com/emitwave/emitwave-php/issues",
        "source": "https://github.com/emitwave/emitwave-php"
    },
    "require": {
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": { "psr-4": { "Emitwave\\": "src/" } },
    "autoload-dev": { "psr-4": { "Emitwave\\Tests\\": "tests/" } }
}
